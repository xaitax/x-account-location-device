{
  "manifest_version": 3,
  "name": "X-Posed: Account Location & Device Info",
  "version": "4.2.0",
  "description": "See where X users are located and what devices they use. Country flags & device icons next to every username. Optional geo-blocking.",
  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "https://x-posed-cache.xaitax.workers.dev/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles/graphite-theme.css", "styles/badges.css", "styles/content.css", "styles/graphite.css", "styles/notifications.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["page-script.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "page-script.js",
        "styles/graphite-theme.css",
        "styles/badges.css",
        "styles/content.css",
        "styles/graphite.css",
        "styles/notifications.css"
      ],
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ]
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X-Posed"
  },

  "commands": {
    "toggle-blocking-mode": {
      "description": "Switch matching posts between Hide and Highlight"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "minimum_chrome_version": "111"
}
